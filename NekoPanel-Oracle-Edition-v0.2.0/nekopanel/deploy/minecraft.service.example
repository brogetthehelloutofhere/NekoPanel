# Example only. Adjust Java heap, jar, loader, and memory limits to your installation.
[Unit]
Description=Minecraft Java Server
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=minecraft
Group=minecraft
WorkingDirectory=/opt/minecraft
ExecStart=/usr/bin/java -Xms2G -Xmx6G -jar fabric-server-launch.jar nogui
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/minecraft
[Install]
WantedBy=multi-user.target
